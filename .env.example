##############################################################################
# x402 Mesh Inference — example environment
#
# Copy to `.env` and edit. `.env` is gitignored; `.env.example` is not, so this
# file must NEVER contain a real key, mnemonic or token.
#
# Legend:
#   [required]  startup fails without it
#   [secret]    never commit, never log, never paste into an issue
#   [default]   safe to leave unset; the shown value is what the code uses
#
# Every variable below is read by `loadGatewayConfig()` or `loadDaemonConfig()`
# in packages/shared/src/config.ts, or by a script under scripts/. Values are
# validated at startup and a bad one fails loudly with the variable named.
##############################################################################


##############################################################################
# 1. GATEWAY — packages/gateway (loadGatewayConfig)
##############################################################################

# TCP port the gateway listens on. Integer 1-65535.
# [default] 8402
PORT=8402

# Bind address. Use 0.0.0.0 in a container, 127.0.0.1 to keep it host-local.
# [default] 0.0.0.0
HOST=0.0.0.0

# Which Algorand network to settle on: "mainnet" or "testnet".
# Start on testnet. Switching this also switches the USDC asset id, which is
# read from avm.USDC_CONFIG rather than hardcoded, so the two cannot desync.
# [default] testnet
MESH_NETWORK=testnet

# Explicit CAIP-2 override for MESH_NETWORK. Only set this if you need to name
# the chain directly. Both encodings are accepted and normalized to canonical
# (truncated genesis hash) form:
#   MainNet  algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73k
#            algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
#   TestNet  algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDe
#            algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# If set alongside MESH_NETWORK and the two disagree, startup fails rather than
# silently preferring one.
# [default] unset (derived from MESH_NETWORK)
#X402_NETWORK=

# x402 facilitator that verifies and settles payments. The default is
# GoPlausible's live Algorand facilitator; it also sponsors the ALGO fee, which
# is what makes payments gasless for your callers.
# [default] https://facilitator.goplausible.xyz
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# [required] Algorand address that receives client payments (the x402 `payTo`).
# 58 characters, base32. THIS ACCOUNT MUST BE OPTED IN TO THE USDC ASA or every
# payment fails — an Algorand account cannot receive an asset it has not opted
# into. Generate one with `npm run keygen`, then run `npm run preflight`.
# The value below is a syntactically valid placeholder; replace it.
X402_PAY_TO_ADDRESS=MESHA65YISXOIW6STKMGJ5AFBZK2UJQNHR3LQZPG2LHIRB4YBPFJPT5WGU

# Price charged to the client per request, as a decimal USDC string with at
# most 6 decimal places. "0.0020" == 2000 atomic units.
# [default] 0.0020
MESH_INBOUND_PRICE_USDC=0.0020

# Per-model overrides of the price above, as a JSON object of model id -> decimal
# USDC string. A 70B model and an 8B model cost wildly different amounts to serve,
# so one flat price is either a loss on the large model or an overcharge on the
# small one. Model ids are matched case-insensitively; anything not listed is
# charged MESH_INBOUND_PRICE_USDC. Prices are validated at boot, so a typo fails
# the deploy rather than a customer's payment.
#
# Each DISTINCT price becomes its own payment middleware and its own facilitator
# sync at boot, so at most 16 distinct prices are allowed. Many models sharing one
# price is free — the cap counts prices, not models.
# [default] none (flat pricing)
# MESH_MODEL_PRICES={"llama-3.3-70b-versatile":"0.0060","llama-3.1-8b-instant":"0.0020"}

# Accrue operator payouts until this much USDC is owed, then pay it in ONE
# transaction. Every payout costs a flat 0.001 ALGO regardless of size — about
# $0.0003 at ALGO $0.30, which is the entire margin on a $0.0020 request and a
# third of it on a $0.0060 one. Batching pays that fee once per batch.
#
# "0" (the default) disables batching: every request is paid immediately, which
# is exactly the behaviour that existed before this option.
#
# TRADE-OFF: while a balance is accrued the gateway is holding USDC it already
# owes. That liability lives in memory. Graceful shutdown flushes it, but a hard
# crash (OOM, SIGKILL, host loss) loses the record of who was owed what — the
# funds stay in the gateway wallet, but nothing remembers to send them. Size
# this against how much you are willing to reconcile by hand.
# [default] 0
# MESH_PAYOUT_BATCH_MIN_USDC=0.05

# Hard ceiling on how long an accrued payout may wait, however small the
# balance. Bounds both how long an operator waits and how much unpaid liability
# a crash can lose, so it is a risk dial rather than a tuning knob.
# [default] 900000 (15 minutes)
# MESH_PAYOUT_BATCH_MAX_DELAY_MS=900000

# Ceiling on how many requests one batch may accumulate — a second flush
# trigger alongside the value threshold. This is a resource bound, not an
# economic one: each accrual rewrites the batch's whole record list to durable
# storage, so N requests cost O(N^2) bytes written. Gating only on value lets
# that grow without limit when payouts are small relative to the threshold.
# The economics stop improving long before it binds — at 100 requests the fee
# is already ~0.06% of the transfer.
# [default] 100
# MESH_PAYOUT_BATCH_MAX_REQUESTS=100

# Gateway margin in basis points (10000 bps == 100%). 1500 bps on a 2000-atomic
# inbound yields exactly 300 margin and 1700 payout with no rounding, matching
# the published economics. The split is computed in integer bigint arithmetic
# and the invariant `inbound - payout == margin` is asserted, never assumed.
# [default] 1500
MESH_MARGIN_BPS=1500

# Externally reachable base URL, used in x402 resource declarations, the 402
# challenge and the /.well-known/x402 manifest. Must be the URL clients actually
# reach — a wrong value produces challenges nobody can pay against.
# [default] http://localhost:${PORT}
#MESH_PUBLIC_BASE_URL=https://mesh.example.com

# Redis connection string for the node registry and settlement log. Leave unset
# for the in-memory backend, which is fine for a single-process demo but loses
# all state on restart and cannot be shared between replicas.
#
# ALSO makes accrued payout balances durable. With payout batching enabled the
# gateway holds USDC it already owes operators; without Redis that record lives
# only in the process, so an OOM kill or a lost host takes it with them — the
# funds stay in the wallet and nothing remembers to send them. The gateway warns
# at startup if batching is on and this is unset.
# [default] unset (in-memory registry)
#REDIS_URL=redis://127.0.0.1:6379

# When true, a node whose operator address has not opted in to USDC is stored
# but never routed to. Turning this off means payouts to such nodes will fail
# after the client has already been charged. Keep it on.
# [default] true
MESH_REQUIRE_USDC_OPT_IN=true

# Allow node endpoints that resolve to private, loopback or link-local addresses.
#
# Node registration is open to anyone who can generate an Algorand keypair, and the gateway
# makes an outbound request to whatever endpoint a node advertises. Leaving this off stops a
# registrant aiming the gateway at cloud instance metadata (169.254.169.254) or at services
# inside your VPC — a server-side request forgery.
#
# Set this to true ONLY for local development and the docker-compose demo, where nodes
# legitimately live on private addresses such as http://node-daemon:8500. Never on a
# publicly reachable gateway.
# [default] false
MESH_ALLOW_PRIVATE_NODE_ENDPOINTS=false

# How many reverse-proxy hops to trust when resolving the client IP.
#
# 0 (the default) ignores X-Forwarded-For entirely and uses the real socket peer. This is
# the only safe value for a gateway that is reachable directly: otherwise any client can
# send a different X-Forwarded-For on every request, get a fresh rate-limit bucket each
# time, and bypass the limiter completely.
#
# If the gateway sits behind N reverse proxies (a load balancer, an ingress, Cloudflare),
# set this to exactly N. Over-counting fails open — it re-enables the spoof.
# [default] 0
MESH_TRUST_PROXY_HOPS=0

# How long a node may go without heartbeating before it stops being routable.
# Nothing else ages a node out: health is only recomputed from request outcomes,
# so a node that is switched off keeps its last-known healthy flag and keeps
# winning selection until enough real requests have failed against it. Observed
# in production: a decommissioned node still listed healthy and routable 105
# minutes after its last heartbeat.
# Default is six missed beats at the daemon's 15s interval.
# [default] 90000
MESH_NODE_STALE_AFTER_MS=90000

# Per-request timeout when proxying to a node, in milliseconds. 1000-600000.
# [default] 120000
MESH_NODE_REQUEST_TIMEOUT_MS=120000

# Cap on concurrent in-flight requests the gateway will send to one node.
# [default] 8
MESH_MAX_CONCURRENT_PER_NODE=8

# pino log level: fatal | error | warn | info | debug | trace | silent
# [default] info
LOG_LEVEL=info

# Enable OpenTelemetry tracing.
# [default] false
OTEL_ENABLED=false

# OTLP/HTTP trace collector endpoint. Only read when OTEL_ENABLED is true.
# [default] unset
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Discovery tag advertised on the paid route. The hackathon requires
# "x402-global-challenge". Note that the Bazaar sanitizer keeps at most the
# first 5 tags, so this one is emitted first.
# [default] x402-global-challenge
X402_CHALLENGE_TAG=x402-global-challenge


##############################################################################
# 2. NODE DAEMON — packages/node-daemon (loadDaemonConfig)
#
# Only needed on a machine contributing GPU capacity. A gateway-only deployment
# can ignore this entire section.
##############################################################################

# [required] Base URL of the mesh gateway this node registers with.
MESH_GATEWAY_URL=http://127.0.0.1:8402

# [required] Stable, operator-chosen node id, unique within the mesh.
# Allowed: alphanumeric start, then alphanumerics and . _ : -
MESH_NODE_ID=gpu-local-01

# [required] Absolute http(s) URL the gateway forwards inference requests to.
# Must be reachable FROM the gateway — 127.0.0.1 only works when both run on
# the same host.
MESH_NODE_ENDPOINT=http://127.0.0.1:8500

# Local TCP port the daemon binds. Defaults to the port implied by MESH_NODE_ENDPOINT.
#
# Set this whenever the public URL's port is not a port the process can bind — the norm
# behind a TLS terminator. On Fly/Render/Railway the endpoint is https:// (port 443) while
# the container listens on an unprivileged port; without this the daemon tries to bind 443
# and a non-root container dies with `EACCES: permission denied 0.0.0.0:443`.
# [default] derived from MESH_NODE_ENDPOINT
#MESH_NODE_PORT=8500

# Inference backend this node drives: ollama | vllm | openai
# [default] ollama
MESH_PROVIDER=ollama

# Base URL of that backend. Defaults per provider:
#   ollama  http://127.0.0.1:11434
#   vllm    http://127.0.0.1:8000
#   openai  https://api.openai.com
# [default] provider-specific (see above)
#MESH_PROVIDER_BASE_URL=http://127.0.0.1:11434

# [secret] Bearer token for the inference backend, when it needs one.
#
# Required for any hosted OpenAI-compatible API (OpenAI, Groq, Together, OpenRouter,
# DeepInfra, Fireworks). Not needed for a local Ollama or an unauthenticated vLLM.
# Read from the environment only — never passed on the command line, and redacted from logs.
# Both `start` and `doctor` send it, so doctor diagnoses the same system that will run.
# [default] unset
#MESH_PROVIDER_API_KEY=

# [required] Comma-separated models this node advertises. Whitespace around
# entries is trimmed; at least one entry is required.
MESH_MODELS=llama3.1:8b,qwen2.5:7b

# How often the daemon heartbeats the gateway, in milliseconds. Miss enough
# heartbeats and the gateway marks the node unhealthy and stops routing to it.
# [default] 15000
MESH_HEARTBEAT_INTERVAL_MS=15000

# Maximum requests this node will serve concurrently.
# [default] 8
MESH_MAX_CONCURRENCY=8

# [required] [secret] Base64 of the 64-byte Algorand secret key (32-byte Ed25519
# seed followed by the 32-byte public key). Used to sign registrations and
# heartbeats, and it derives the operator payout address.
#
#   * Generate with `npm run keygen`.
#   * The derived address MUST be opted in to the USDC ASA before the node can
#     be paid. `npm run preflight` checks this.
#   * NEVER commit this, never log it, never paste it anywhere. Anyone holding
#     it can move your funds.
#
# The value below is a structurally valid but WORTHLESS all-zero placeholder so
# that config validation passes in a scratch environment. Replace it.
AVM_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==


##############################################################################
# 3. SCRIPTS AND COMPOSE — scripts/*.ts and docker/docker-compose.yml
#    (not read by the services themselves)
##############################################################################

# Model the one-command demo pulls into Ollama and advertises. A 1B model keeps
# the first `docker compose up` to a small download and runs acceptably on CPU;
# swap it for something larger once the loop works.
# [default] llama3.2:1b
#MESH_DEMO_MODEL=llama3.2:1b

# algod REST endpoint used by `npm run preflight` to check ALGO balance and the
# USDC opt-in. Defaults by network:
#   mainnet  https://mainnet-api.algonode.cloud
#   testnet  https://testnet-api.algonode.cloud
# [default] network-specific (see above)
#ALGOD_URL=https://testnet-api.algonode.cloud

# [secret] Token for a private algod node, sent as the X-Algo-API-Token header.
# Public AlgoNode endpoints need no token; leave unset for them.
# [default] unset
#ALGOD_TOKEN=

# Gateway base URL the end-to-end harnesses drive.
#   scripts/e2e-simulate.ts  — optional. Unset runs the harness against its
#                              built-in stub gateway, so CI is meaningful with
#                              no secrets and no network.
#   scripts/e2e-mainnet.ts   — [required] for that script.
# [default] unset (stub mode)
#MESH_E2E_BASE_URL=http://127.0.0.1:8402

# Model the harnesses request. Unset picks the first model advertised by a
# healthy node.
# [default] unset (auto-detect)
#MESH_E2E_MODEL=llama3.1:8b

# Safety interlock for `npm run test:e2e-mainnet`, which SPENDS REAL USDC ON
# ALGORAND MAINNET. The script refuses to run unless this is set to exactly:
#   I_UNDERSTAND_THIS_SPENDS_REAL_USDC
# Leave it unset. Set it in your shell for the one invocation, not in .env.
# [default] unset (script refuses to run)
#X402_MAINNET_CONFIRM=
